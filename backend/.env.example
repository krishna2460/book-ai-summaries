# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://booksumm:booksumm_secret@localhost:5432/booksumm
DATABASE_URL_SYNC=postgresql+psycopg2://booksumm:booksumm_secret@localhost:5432/booksumm

# ── AIMLAPI (OpenAI-compatible) ─────────────────────────
AIML_API_KEY=your-aimlapi-key-here
AIML_BASE_URL=https://api.aimlapi.com/v1
AIML_CHAT_MODEL=gpt-4o-mini
AIML_EMBEDDING_MODEL=text-embedding-3-small

# ── Groq (used for chat and summaries when configured) ───
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=allam-2-7b

# ── Google Gemini (takes precedence when configured) ─────
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: comma-separated keys from different Google projects.
# GEMINI_API_KEYS=key-from-project-a,key-from-project-b,key-from-project-c
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Langfuse (observability) ─────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── App ───────────────────────────────────────────────────
UPLOAD_DIR=./uploads
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
